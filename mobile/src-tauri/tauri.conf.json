{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-template-mobile",
  "version": "0.1.0",
  "identifier": "id.example.apptemplate.mobile",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev:mobile",
    "beforeBuildCommand": "bun run build:mobile"
  },
  "app": {
    "windows": [
      {
        "title": "App Template Mobile",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://tauri.localhost http://10.0.2.2:* http://localhost:* http://127.0.0.1:* https:* http:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null,
      "freezePrototype": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
