{
  "name": "app-template-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:mobile": "bun scripts/dev-target.ts",
    "build": "bun run build:mobile",
    "build:mobile": "bun scripts/build-target.ts mobile",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:dev:usb": "tauri android dev --ip 127.0.0.1",
    "tauri:android:build": "tauri android build",
    "tauri:android:build:arm64": "tauri android build --target aarch64",
    "tauri:android:build:split": "tauri android build --split-per-abi",
    "tauri:ios": "tauri ios",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:quick": "bun run lint && bun run typecheck && bun run test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:rust"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "^2.2.0",
    "@zxing/browser": "0.2.0",
    "exceljs": "4.4.0",
    "next": "16.3.0",
    "postcss": "^8.5.26",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tauri-apps/cli": "^2.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
